---
parameters:
- name: "build_dir"
constants:
- name: "project_name"
  value: "bluetipz-rx-efr32bg21-sdk2026-6-1"
steps:
- task: "convert"
  output: "artifact/{{project_name}}.s37"
  export: "application_binary"
  input: "{{build_dir}}/{{project_name}}.out"
- task: "convert"
  output: "artifact/{{project_name}}_combined.s37"
  input:
  - "bootloader/deepfreeze_tx_mg_bootloader.s37"
  - "artifact/{{project_name}}.s37"
- task: "create_gbl"
  output: "artifact/{{project_name}}.gbl"
  app: "{{build_dir}}/{{project_name}}.out"
