# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: bluetipz-rx-efr32bg21-sdk2026-6-1
label: bluetipz-rx-efr32bg21-sdk2026-6-1
description: |
  BlueTipz Rx (receiver) firmware for the EFR32BG21A020F512IM32. Ported from the Gecko SDK 4.3.1 project i3proddev-4676-bluetipz-rx-efr32bg21-sdk4-3-1 (firmware 03.00.04) to Simplicity SDK 2026.6.1. See ../../rx_port_to_2026-6-1_report.md.
category: Bluetooth Examples
filter:
- name: Device Type
  value:
  - SoC
- name: Wireless Technology
  value:
  - Bluetooth
package: bluetooth_le_app
quality: production
readme:
- path: readme.md
source:
- path: app.c
tag:
- hwfilter:device:device_supports_bluetooth
- hwfilter:device:device_series_2
include:
- path: .
  file_list:
  - path: app.h
  - path: bluetipz_pins.h
  - path: common.h
  - path: version.h
sdk:
  vendor: silabs
  id: simplicity_sdk
  version: 2026.6.1
